APP_NAME=CSCI599 Multi-Agent Research Assistant
APP_ENV=development
LOG_LEVEL=INFO

OPENAI_API_KEY=
SUPERVISOR_PROVIDER=openai
SUPERVISOR_MODEL=gpt-5.1
CODE_PROVIDER=openai
CODE_MODEL=gpt-5.1

GOOGLE_API_KEY=
RESEARCH_PROVIDER=google
RESEARCH_MODEL=gemini-2.5-flash
SUMMARY_PROVIDER=google
SUMMARY_MODEL=gemini-2.5-flash

TAVILY_API_KEY=
TAVILY_TIMEOUT_SECONDS=30
TAVILY_MAX_RESULTS=5
RESEARCH_TIMEOUT_SECONDS=60

CHROMA_PERSIST_DIR=./data/chroma_index
CHROMA_COLLECTION=technical_documents
CORPUS_DIR=./data/corpus
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RETRIEVAL_TOP_K=5

GCP_PROJECT_ID=
GCP_REGION=us-west1
CLOUD_RUN_SERVICE=csci599-multi-agent
